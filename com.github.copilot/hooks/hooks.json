{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$COPILOT_PLUGIN_ROOT/copilot-mem.mjs\" hook SessionStart",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$COPILOT_PLUGIN_ROOT/copilot-mem.mjs\" hook UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$COPILOT_PLUGIN_ROOT/copilot-mem.mjs\" hook PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$COPILOT_PLUGIN_ROOT/copilot-mem.mjs\" hook PostToolUseFailure",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$COPILOT_PLUGIN_ROOT/copilot-mem.mjs\" hook Stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$COPILOT_PLUGIN_ROOT/copilot-mem.mjs\" hook SubagentStop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$COPILOT_PLUGIN_ROOT/copilot-mem.mjs\" hook SessionEnd",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
